<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/hunters_healthbar/hunters_healthbar.css"/>
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/hunters_healthbar/hunters_healthbar.js"/>
	</scripts>
	<Panel class="Root" hittest="false" hittestchildren="true">
        <Panel id="MainPanel" class="Hidden" hittest="false" >
            <Panel id="HeroMovieConatiner"/>
            <Panel id="HeroBarsContainer">
                <Panel id="EnergyBarContainer">
                    <Panel id="EnergyBarBG" class="BarBG"/>
                    <Panel id="EnergyBarMID" class="BarMID"/>
                    <Panel id="EnergyBarFG" class="BarFG">
                        <DOTAScenePanel id="EnergyScene" map="hud/shildbarburner" camera="camera_1"/>
                    </Panel>
                    <Label id="EnergyBarCount" class="BGText" text="" />
                </Panel>
                <Panel id="HPBarContainer">
                    <Panel id="HPBarBG" class="BarBG"/>
                    <Panel id="HPBarMID" class="BarMID"/>
                    <Panel id="HPBarFG" class="BarFG">
                        <DOTAScenePanel id="HPScene" map="hud/healthbarburner" camera="camera_1"/>
                    </Panel>
                    <Panel id="ShildBarMID" class="BarMID"/>
                    <Panel id="ShildBarFG" class="BarFG"/>
                    <Label id="HPBarCount" class="BGText" text="" />
                </Panel>
            </Panel>
        </Panel>
    </Panel>
</root>