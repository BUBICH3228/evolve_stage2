<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/monster_health_bar/monster_health_bar.css"/>
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/monster_health_bar/monster_health_bar.js"/>
	</scripts>
	<Panel class="Root" hittest="false" hittestchildren="true">
        <Panel id="MainPanel" hittest="false" >
            <Panel id="HeroBarsContainer">
                <Panel id="HPBarContainer">
                    <Panel id="HPBarBG" class="BarBG"/>
                    <Panel id="HPBarMID" class="BarMID"/>
                    <Panel id="HPBarFG" class="BarFG">
                        <DOTAScenePanel id="HPScene" map="hud/healthbarburner" camera="camera_2"/>
                    </Panel>
                    <Label id="HPBarCount" class="BGText" text="" />
                </Panel>
                <Panel id="EvolutionPaneContainer">
                    <Panel id="EvolutionPanel">
                    <DOTAScenePanel id="EvolutionScene" map="hud/shildbarburner" camera="camera_3"/>
                    </Panel>
                    <Label id="EvolutionPoints" class="Text" text=" 1 / 1" />
                    
                </Panel>
                <Panel id="ShildBarContainer">
                    <Panel id="ShildBarBG" class="BarBG"/>
                    <Panel id="ShildBarMID" class="BarMID"/>
                    <Panel id="ShildBarFG" class="BarFG">
                        <DOTAScenePanel id="ShildScene" map="hud/shildbarburner" camera="camera_1"/>
                    </Panel>
                    <Label id="ShildBarCount" class="BGText" text="" />
                </Panel>
            </Panel>
        </Panel>
    </Panel>
</root>